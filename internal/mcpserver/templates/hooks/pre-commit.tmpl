#!/bin/sh
# generated by spectackle `commands install-hooks` — edit internal/mcpserver/templates/hooks, not this file
#
# MCP-015: WHEN a commit inside a linked git worktree stages any
# `.spectackle` path, exit 1 naming every offending path. Code-only
# commits are left untouched, and so is any commit made from the MAIN
# checkout — this hook only fires inside a linked worktree, because that is
# exactly where the sanctioned `work op=submit` flow commits code and
# nothing else should ever slip a spec-state file onto that branch.

set -eu

# A linked worktree's git-dir lives under <main>/.git/worktrees/<name>,
# distinct from the repository's common git-dir; the main checkout's
# git-dir IS the common dir. Comparing the two (after resolving both to
# absolute paths, since `git rev-parse --git-common-dir` may print a path
# relative to the current directory on older git) is how a linked worktree
# is told apart from the main checkout — never by pattern-matching a
# directory name.
git_dir=$(git rev-parse --absolute-git-dir 2>/dev/null) || exit 0
common_dir=$(git rev-parse --git-common-dir 2>/dev/null) || exit 0
case "$common_dir" in
  /*) : ;;
  *) common_dir=$(cd "$common_dir" && pwd) ;;
esac

if [ "$git_dir" = "$common_dir" ]; then
  # main checkout: not a linked worktree, this hook has nothing to say.
  exit 0
fi

offenders=$(git diff --cached --name-only | grep -E '(^|/)\.spectackle(/|$)' || true)

if [ -n "$offenders" ]; then
  echo "pre-commit: refusing to commit .spectackle path(s) from a worktree branch (MCP-015 — .spectackle is server-owned; code-only commits belong here):" >&2
  echo "$offenders" | while IFS= read -r path; do
    [ -n "$path" ] && echo "  $path" >&2
  done
  exit 1
fi

exit 0
